# Copy to .env.local and fill in. Never commit real values.
# Local: `npx supabase status -o env`. Cloud: Supabase dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (webhooks, cron). Never prefix with NEXT_PUBLIC_ and never import from client code.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Step 6: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Step 8: emails
RESEND_API_KEY=

# Step 4: protects the iCal sync endpoint
CRON_SECRET=
